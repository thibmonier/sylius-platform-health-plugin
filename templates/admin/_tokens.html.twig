{# Colour tokens of the platform health page. The administration of Sylius 2 (Tabler) switches the theme with data-bs-theme on <html>. #}
<style>
    :root,
    [data-bs-theme="light"] {
        --tph-surface: #ffffff;
        --tph-text: #212529;
        --tph-muted: #6c757d;
        --tph-link: #0d6efd;
        --tph-ok-text: #ffffff;
        --tph-ok-bg: #198754;
        --tph-ok-icon: #ffffff;
        --tph-ok-border: #198754;
        --tph-warning-text: #ffc107;
        --tph-warning-bg: #fff3cd;
        --tph-warning-icon: #ffc107;
        --tph-warning-border: #ffc107;
        --tph-critical-text: #dc3545;
        --tph-critical-bg: #f8d7da;
        --tph-critical-icon: #dc3545;
        --tph-critical-border: #dc3545;
        --tph-unknown-text: #adb5bd;
        --tph-unknown-bg: #f8f9fa;
        --tph-unknown-icon: #adb5bd;
        --tph-unknown-border: #ced4da;
    }

    [data-bs-theme="dark"] {
        --tph-surface: #182433;
        --tph-text: #dee2e6;
        --tph-muted: #6c757d;
        --tph-link: #0d6efd;
        --tph-ok-text: #198754;
        --tph-ok-bg: #182433;
        --tph-ok-icon: #198754;
        --tph-ok-border: #198754;
        --tph-warning-text: #ffc107;
        --tph-warning-bg: #332701;
        --tph-warning-icon: #ffc107;
        --tph-warning-border: #ffc107;
        --tph-critical-text: #dc3545;
        --tph-critical-bg: #2c0b0e;
        --tph-critical-icon: #dc3545;
        --tph-critical-border: #dc3545;
        --tph-unknown-text: #6c757d;
        --tph-unknown-bg: #212529;
        --tph-unknown-icon: #6c757d;
        --tph-unknown-border: #495057;
    }
</style>
