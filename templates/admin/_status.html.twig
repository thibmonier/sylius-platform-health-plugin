{# One status, always written and always drawn: the word, and an icon whose shape differs for each status (WCAG 1.4.1).
   The icon is decorative (aria-hidden): the word carries the meaning, the colour only reinforces it. #}
{% macro icon(status) %}
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false" data-test-health-icon="{{ status }}">
        {% if status == 'ok' %}
            <circle cx="12" cy="12" r="9"/><path d="M8.5 12.5l2.5 2.5l4.5-5"/>
        {% elseif status == 'warning' %}
            <path d="M12 4l9 16H3z"/><path d="M12 10v4"/><path d="M12 17.5v.01"/>
        {% elseif status == 'critical' %}
            <path d="M8 3h8l5 5v8l-5 5H8l-5-5V8z"/><path d="M9 9l6 6M15 9l-6 6"/>
        {% else %}
            <circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.7.4-1 .9-1 1.7"/><path d="M12 17v.01"/>
        {% endif %}
    </svg>
{% endmacro %}

{% macro category(status) %}
    <span class="tph-status tph-status--{{ status }}" data-test-health-category-status>{{ _self.icon(status) }}<span>{{ ('tmonier_platform_health.status.' ~ status)|trans }}</span></span>
{% endmacro %}

{% macro check(status) %}
    <span class="tph-status tph-status--{{ status }}" data-test-health-status-label>{{ _self.icon(status) }}<span>{{ ('tmonier_platform_health.status.' ~ status)|trans }}</span></span>
{% endmacro %}
