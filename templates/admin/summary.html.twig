{% macro placeholder() %}
    <div class="card" role="status" data-test-health-skeleton>
        <div class="card-body text-muted">
            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
            {{ 'tmonier_platform_health.ui.loading'|trans }}
        </div>
    </div>
{% endmacro %}

<div {{ attributes }} data-test-health-results>
    {% set snapshot = this.snapshot %}

    <div class="d-flex justify-content-between align-items-center mb-3">
        <p class="text-muted mb-0" data-test-health-generated-at>
            {{ 'tmonier_platform_health.ui.generated_at'|trans({'%time%': snapshot.generatedAt|date('H:i:s')}) }}
        </p>
        <button type="button" class="btn btn-outline-primary btn-sm" data-action="live#action" data-live-action-param="refresh" data-test-health-refresh>
            {{ 'tmonier_platform_health.ui.refresh'|trans }}
        </button>
    </div>

    {% include '@TmonierSyliusPlatformHealthPlugin/admin/_summary.html.twig' with { categories: this.categories } only %}
</div>
